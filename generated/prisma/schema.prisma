// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
  CONTRACTOR
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id          String  @id @default(cuid())
  name        String
  image       String?
  bannerImage String?
  description String?
  website     String?
  email       String?
  phone       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     CompanyMember[]
  channels    Channel[]
  jobs        Job[]
  posts       CompanyPost[]
  invitations CompanyInvitation[]
}

model CompanyMember {
  id String @id @default(cuid())

  userId    String
  companyId String
  role      CompanyRole @default(MEMBER)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Channel {
  id             String          @id @default(cuid())
  name           String
  image          String?
  messages       Message[]
  channelMembers ChannelMember[]

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([companyId])
}

model ChannelMember {
  id                  String    @id @default(cuid())
  channelId           String
  userId              String
  canSendMessages     Boolean   @default(false)
  canManageMembers    Boolean   @default(false)
  canManageChannel    Boolean   @default(false)
  canModerateMessages Boolean   @default(false)
  joinedAt            DateTime  @default(now())
  removedAt           DateTime?

  channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([channelId, userId])
  // Allows the message foreign key to enforce that its author is in this channel.
  @@unique([id, channelId])
  @@index([userId, removedAt])
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  emailVerificationCode EmailVerificationCode?
  passwordHash          String?
  sessionVersion        Int                    @default(0)
  twoFactor             TwoFactor?
  twoFactorChallenges   TwoFactorChallenge[]
  image                 String?
  description           String?

  accounts Account[]
  sessions Session[]

  companyMemberships  CompanyMember[]
  channelMemberships  ChannelMember[]
  createdJobs         Job[]
  companyPosts        CompanyPost[]
  postAcknowledgments CompanyPostAcknowledgment[]
  sentInvitations     CompanyInvitation[]
}

model CompanyInvitation {
  id          String      @id @default(cuid())
  companyId   String
  email       String
  role        CompanyRole @default(MEMBER)
  tokenHash   String      @unique
  createdById String
  createdAt   DateTime    @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([email, expiresAt])
  @@index([createdById, createdAt])
}

model EmailVerificationCode {
  userId     String   @id
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id        String    @id @default(cuid())
  content   String
  postedAt  DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  authorChannelMemberId String
  authorChannelMember   ChannelMember @relation(fields: [authorChannelMemberId, channelId], references: [id, channelId], onDelete: NoAction)

  @@index([channelId, postedAt, id])
  @@index([authorChannelMemberId, channelId])
}

model Job {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  createdById String

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])
}

model CompanyPost {
  id        String   @id @default(cuid())
  title     String   @default("Company Update")
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String
  authorId  String?

  company         Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author          User?                       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  acknowledgments CompanyPostAcknowledgment[]

  @@index([companyId, createdAt, id])
}

model CompanyPostAcknowledgment {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CompanyPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TwoFactor {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted  String?
  pendingEncrypted String?
  pendingExpiresAt DateTime?
  lastUsedStep     Int?
  recoveryHashes   String[]  @default([])
  attempts         Int       @default(0)
  windowStartedAt  DateTime  @default(now())
}

model TwoFactorChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}
