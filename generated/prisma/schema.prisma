// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection: the pooler can strand
  // Prisma's migration advisory lock on a shared connection.
  directUrl = env("DIRECT_URL")
}

enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
  CONTRACTOR
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id          String  @id @default(cuid())
  name        String
  image       String?
  bannerImage String?
  description String?
  website     String?
  email       String?
  phone       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     CompanyMember[]
  channels    Channel[]
  jobs        Job[]
  posts       CompanyPost[]
  invitations CompanyInvitation[]
}

model CompanyMember {
  id String @id @default(cuid())

  userId    String
  companyId String
  role      CompanyRole @default(MEMBER)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

enum ChannelKind {
  CHANNEL
  DIRECT
}

model Channel {
  id             String          @id @default(cuid())
  kind           ChannelKind     @default(CHANNEL)
  // Empty for direct messages; the UI shows the other member's name.
  name           String
  // Storage key of the channel icon. Channel files are private and signed on read.
  image          String?
  // "<companyId>:<userId>:<userId>" (sorted) so each pair has one direct message.
  directKey      String?         @unique
  messages       Message[]
  channelMembers ChannelMember[]
  reads          ChannelRead[]

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([companyId])
}

model ChannelMember {
  id                  String    @id @default(cuid())
  channelId           String
  userId              String
  canSendMessages     Boolean   @default(false)
  canManageMembers    Boolean   @default(false)
  canManageChannel    Boolean   @default(false)
  canModerateMessages Boolean   @default(false)
  joinedAt            DateTime  @default(now())
  removedAt           DateTime?

  channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([channelId, userId])
  // Allows the message foreign key to enforce that its author is in this channel.
  @@unique([id, channelId])
  @@index([userId, removedAt])
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  emailVerificationCode EmailVerificationCode?
  passwordHash          String?
  sessionVersion        Int                    @default(0)
  twoFactor             TwoFactor?
  twoFactorChallenges   TwoFactorChallenge[]
  image                 String?
  description           String?

  accounts Account[]
  sessions Session[]

  companyMemberships     CompanyMember[]
  channelMemberships     ChannelMember[]
  createdJobs            Job[]
  jobMemberships         JobMember[]
  jobTileAcknowledgments JobTileAcknowledgment[]
  jobTileAnswers         JobTileAnswer[]
  companyPosts           CompanyPost[]
  postAcknowledgments    CompanyPostAcknowledgment[]
  sentInvitations        CompanyInvitation[]
  imageUploads           ImageUpload[]
  channelReads           ChannelRead[]
  messageEdits           MessageEdit[]
}

// When a user last read a channel or direct message. Separate from
// ChannelMember because the owner can read channels without being a member.
model ChannelRead {
  channelId  String
  userId     String
  lastReadAt DateTime

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

// Upload URLs issued to a user. Confirming an upload requires its record, and
// recent records enforce the upload rate limit.
model ImageUpload {
  id          String    @id @default(cuid())
  key         String    @unique
  userId      String
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CompanyInvitation {
  id          String      @id @default(cuid())
  companyId   String
  email       String
  role        CompanyRole @default(MEMBER)
  tokenHash   String      @unique
  createdById String
  createdAt   DateTime    @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([email, expiresAt])
  @@index([createdById, createdAt])
}

model EmailVerificationCode {
  userId     String   @id
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum MessageType {
  TEXT
  IMAGE
}

model Message {
  id        String      @id @default(cuid())
  type      MessageType @default(TEXT)
  // Text body, or the caption of an image ("" when there is none).
  content   String
  // Type-specific payload, validated by src/server/messages/types.ts.
  data      Json?
  postedAt  DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  // Set when the author changes the text, shown as "(edited)".
  editedAt  DateTime?
  deletedAt DateTime?

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  authorChannelMemberId String
  authorChannelMember   ChannelMember @relation(fields: [authorChannelMemberId, channelId], references: [id, channelId], onDelete: NoAction)
  edits                 MessageEdit[]

  @@index([channelId, postedAt, id])
  @@index([authorChannelMemberId, channelId])
}

// One row per edit, so repeated edits of a message count towards the rate limit.
model MessageEdit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  editorId String
  editor   User   @relation(fields: [editorId], references: [id], onDelete: Cascade)

  @@index([editorId, createdAt])
  @@index([messageId])
}

model Job {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  createdById String

  // Private storage key; reads use signed URLs.
  photo String?

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User        @relation(fields: [createdById], references: [id])
  members   JobMember[]
  tiles     JobTile[]
}

model JobMember {
  jobId     String
  userId    String
  createdAt DateTime  @default(now())
  // Set when the person leaves the company, keeping who worked on the job.
  removedAt DateTime?

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([jobId, userId])
  @@index([userId])
}

// config and visibility hold the tile's fields from ~/lib/job-tiles, by type.
model JobTile {
  id                     String    @id @default(cuid())
  jobId                  String
  type                   String
  position               Int
  config                 Json
  visibility             Json
  // Whether the people who can see it are asked to acknowledge it.
  requiresAcknowledgment Boolean   @default(false)
  // Set when the tile is taken off the job, so its answers are kept.
  removedAt              DateTime?

  job             Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  acknowledgments JobTileAcknowledgment[]
  answers         JobTileAnswer[]

  @@index([jobId, position])
}

// What someone entered on a tile, e.g. a checklist tick. `data` fits the tile
// type's answer schema; the author is kept null if their account is deleted.
model JobTileAnswer {
  id        String   @id @default(cuid())
  tileId    String
  authorId  String?
  data      Json
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tile   JobTile @relation(fields: [tileId], references: [id], onDelete: Cascade)
  author User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([tileId, createdAt])
  @@index([authorId])
}

model JobTileAcknowledgment {
  tileId    String
  userId    String
  createdAt DateTime @default(now())

  tile JobTile @relation(fields: [tileId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tileId, userId])
  @@index([userId])
}

model CompanyPost {
  id        String   @id @default(cuid())
  title     String   @default("Company Update")
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String
  authorId  String?

  company         Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author          User?                       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  acknowledgments CompanyPostAcknowledgment[]

  @@index([companyId, createdAt, id])
}

model CompanyPostAcknowledgment {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CompanyPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TwoFactor {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted  String?
  pendingEncrypted String?
  pendingExpiresAt DateTime?
  lastUsedStep     Int?
  recoveryHashes   String[]  @default([])
  attempts         Int       @default(0)
  windowStartedAt  DateTime  @default(now())
}

model TwoFactorChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}
