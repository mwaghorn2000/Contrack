# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET="CHANGE_THIS_IN_PROD"
# Also encrypts authenticator secrets. Keep it stable and backed up: changing it
# invalidates sessions and makes existing authenticator secrets unreadable.

# Next Auth Discord Provider
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/contrack"
# Used by migrations. On Neon, this is DATABASE_URL without "-pooler" in the
# hostname. Locally it can be the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:password@localhost:5432/contrack"

# Public application origin used in invitation emails (HTTPS in production).
APP_URL="http://localhost:3000"

# Image uploads (profile photos, company logos and banners). Any S3-compatible
# bucket works, e.g. Cloudflare R2 or AWS S3 in ap-southeast-2. Leave
# S3_ENDPOINT empty for AWS S3. S3_PUBLIC_URL is the public base URL objects are
# served from (a custom domain or CDN in production). The bucket must allow
# public reads and CORS PUT requests from APP_URL.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# Realtime chat (Pusher Channels, cluster "ap4" for Sydney). Without these, chat
# still works but checks for new messages every few seconds instead.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
